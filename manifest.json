{
  "tools": [
    {"name": "nuclei", "version": "3.11.1", "arg": "NUCLEI_VERSION", "source": "github:projectdiscovery/nuclei",
     "probe": ["nuclei", "-version", "-duc"], "match": "v(\\d+\\.\\d+\\.\\d+)",
     "notes": "the baked HTTP template subset is the default (nuclei_templates)"},
    {"name": "httpx", "version": "1.12.0", "arg": "HTTPX_VERSION", "source": "github:projectdiscovery/httpx",
     "probe": ["httpx", "-version", "-duc"], "match": "v(\\d+\\.\\d+\\.\\d+)",
     "notes": "the ProjectDiscovery HTTP prober (not the Python httpx library of the same command name, which is removed from PATH)"},
    {"name": "katana", "version": "1.8.0", "arg": "KATANA_VERSION", "source": "github:projectdiscovery/katana",
     "probe": ["katana", "-version", "-duc"], "match": "v(\\d+\\.\\d+\\.\\d+)",
     "notes": "web crawler"},
    {"name": "subfinder", "version": "2.17.0", "arg": "SUBFINDER_VERSION", "source": "github:projectdiscovery/subfinder",
     "probe": ["subfinder", "-version", "-duc"], "match": "v(\\d+\\.\\d+\\.\\d+)",
     "notes": "passive subdomain enumeration"},
    {"name": "ffuf", "version": "2.3.0", "arg": "FFUF_VERSION", "source": "github:ffuf/ffuf",
     "probe": ["ffuf", "-V"], "match": "(\\d+\\.\\d+\\.\\d+)"},
    {"name": "dalfox", "version": "3.2.4", "arg": "DALFOX_VERSION", "source": "github:hahwul/dalfox",
     "probe": ["dalfox", "--version"], "match": "dalfox (\\d+\\.\\d+\\.\\d+)"},
    {"name": "sqlmap", "version": "1.10.11", "arg": "SQLMAP_VERSION", "source": "git:sqlmapproject/sqlmap",
     "probe": ["sqlmap", "--version"], "match": "(\\d+\\.\\d+\\.\\d+)",
     "notes": "a checkout pinned to a commit, linked onto PATH"},
    {"name": "jq", "version": "1.8.2", "arg": "JQ_VERSION", "source": "github:jqlang/jq",
     "probe": ["jq", "--version"], "match": "jq-(\\d+\\.\\d+\\.\\d+)"},
    {"name": "rg", "version": "15.2.0", "arg": "RIPGREP_VERSION", "source": "github:BurntSushi/ripgrep",
     "probe": ["rg", "--version"], "match": "ripgrep (\\d+\\.\\d+\\.\\d+)"},
    {"name": "jwt-secret-check", "version": "1", "source": "repo:scripts/jwt-secret-check.py",
     "probe": ["jwt-secret-check", "--version"], "match": "jwt-secret-check (\\d+)",
     "notes": "offline HMAC JWT secret guessing against a bundled list; versioned with the file"},
    {"name": "playwright-cli", "version": "0.1.23", "arg": "PLAYWRIGHT_CLI_VERSION", "source": "npm:@playwright/cli",
     "probe": ["playwright-cli", "--version"], "match": "(\\d+\\.\\d+\\.\\d+)",
     "notes": "drives the image Chromium (PLAYWRIGHT_MCP_BROWSER=chromium)"},
    {"name": "playwright-mcp", "version": "0.0.84", "arg": "PLAYWRIGHT_MCP_VERSION", "source": "npm:@playwright/mcp",
     "probe": ["playwright-mcp", "--version"], "match": "(\\d+\\.\\d+\\.\\d+)",
     "notes": "the browser MCP server; same Playwright build and Chromium as playwright-cli"},
    {"name": "chromium", "version": "157.0.8103.15", "source": "playwright:chromium",
     "probe": ["chromium", "--version"], "match": "Chrome for Testing (\\d+\\.\\d+\\.\\d+\\.\\d+)",
     "notes": "the revision @playwright/mcp and @playwright/cli are built for, installed by their own Playwright"},
    {"name": "curl", "version": "7.88.1", "source": "apt", "probe": ["curl", "--version"],
     "match": "curl (\\d+\\.\\d+\\.\\d+)", "notes": "Debian bookworm, security fixes backported"},
    {"name": "wget", "version": "1.21.3", "source": "apt", "probe": ["wget", "--version"],
     "match": "Wget (\\d+\\.\\d+\\.\\d+)"},
    {"name": "git", "version": "2.39.5", "source": "apt", "probe": ["git", "--version"],
     "match": "git version (\\d+\\.\\d+\\.\\d+)"},
    {"name": "node", "version": "22.x", "source": "apt:nodesource-22", "probe": ["node", "--version"],
     "match": "v(\\d+\\.\\d+\\.\\d+)"},
    {"name": "npm", "version": "10.x", "source": "apt:nodesource-22", "probe": ["npm", "--version"],
     "match": "(\\d+\\.\\d+\\.\\d+)", "notes": "no installs at run time"},
    {"name": "npx", "version": "10.x", "source": "apt:nodesource-22", "probe": ["npx", "--version"],
     "match": "(\\d+\\.\\d+\\.\\d+)", "notes": "resolves the global installs only; no downloads"},
    {"name": "python3", "version": "3.12.x", "source": "docker:python:3.12-slim-bookworm", "probe": ["python3", "--version"],
     "match": "Python (\\d+\\.\\d+\\.\\d+)", "notes": "see python for the libraries"},
    {"name": "dig", "version": "9.18.x", "source": "apt:dnsutils", "probe": ["dig", "-v"],
     "match": "DiG (\\d+\\.\\d+\\.\\d+)", "notes": "for an interactive root shell"},
    {"name": "nc", "version": "1.219", "source": "apt:netcat-openbsd", "probe": ["nc", "-h"],
     "match": "OpenBSD netcat \\(Debian patchlevel (\\d+\\.\\d+)",
     "notes": "for an interactive root shell"}
  ],
  "python": [
    {"name": "requests", "version": "2.34.2", "import": "requests"},
    {"name": "httpx", "version": "0.28.1", "import": "httpx"},
    {"name": "PyJWT", "version": "2.15.1", "import": "jwt"},
    {"name": "cryptography", "version": "50.0.2", "import": "cryptography"},
    {"name": "Werkzeug", "version": "3.1.9", "import": "werkzeug"}
  ],
  "nuclei_templates": {"version": "10.5.1", "arg": "NUCLEI_TEMPLATES_VERSION", "dir": "/opt/nuclei-templates"},
  "system": [
    "sh", "bash", "cat", "cp", "mv", "rm", "ls", "mkdir", "find", "grep", "sed", "awk", "head", "tail", "sort",
    "uniq", "wc", "cut", "tr", "tee", "xargs", "diff", "base64", "sha256sum", "timeout", "env", "sleep", "date",
    "gzip", "tar", "openssl", "setpriv"
  ],
  "absent": [
    {"name": "nmap", "reason": "port scanner; not included"},
    {"name": "bbot", "reason": "not included; its module dependencies were several GB of image size"},
    {"name": "masscan", "reason": "port scanner; not included"},
    {"name": "naabu", "reason": "port scanner; not included"},
    {"name": "zmap", "reason": "port scanner; not included"},
    {"name": "rustscan", "reason": "port scanner; not included"},
    {"name": "unicornscan", "reason": "port scanner; not included"},
    {"name": "hping3", "reason": "raw packet tool; not included"},
    {"name": "dnsx", "reason": "not included"},
    {"name": "whois", "reason": "not included"},
    {"name": "ping", "reason": "not included (no raw-socket capability)"},
    {"name": "telnet", "reason": "not included"},
    {"name": "playwright", "reason": "the Playwright test runner package is not shipped; the browsers come from @playwright/mcp's own Playwright"},
    {"name": "hashcat", "reason": "GPU cracker, over the image budget; jwt-secret-check covers weak HMAC secrets"},
    {"name": "john", "reason": "the Debian build has no JWT format; jwt-secret-check covers weak HMAC secrets"},
    {"name": "jwt_tool", "reason": "not shipped; PyJWT and jwt-secret-check cover forging and secret checks"},
    {"name": "ghidriff", "reason": "needs Java and Ghidra, over the image budget"},
    {"name": "docker", "reason": "no container runtime in the image"},
    {"name": "php", "reason": "no PHP in the image"}
  ]
}
